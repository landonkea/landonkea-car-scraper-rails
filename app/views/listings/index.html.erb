<%# Sets the browser tab title for just this page, overriding the layout's default. %>
<% content_for :title, "Car Scraper Dashboard" %>

<div class="w-full pb-16">
  <%# Page heading -- plain text, no framework needed for something this simple. %>
  <h1 class="text-2xl font-bold text-gray-900">Car Scraper Dashboard</h1>
  <%# One-line explainer so a first-time visitor knows what they're looking at. %>
  <p class="mt-1 text-sm text-gray-600">Every active listing found across Craigslist, OfferUp, eBay, and CarGurus, best score first.</p>

  <%# The summary line -- mirrors the run summary the Python version printed to the terminal after every scrape. %>
  <p class="mt-4 text-sm text-gray-700">
    <span class="font-semibold"><%= @total_count %></span> active listings,
    <span class="font-semibold text-green-700"><%= @great_deal_count %></span> flagged as great deals (at or under $<%= number_with_delimiter(Listing::GREAT_DEAL_PRICE_USD) %>).
  </p>

  <%# The filter form -- a plain GET form so the filters show up right in the URL and are bookmarkable/shareable. %>
  <%= form_with url: listings_path, method: :get, local: true, class: "mt-6 flex flex-wrap items-end gap-4 bg-white p-4 rounded-lg border border-gray-200" do %>
    <div>
      <%# Dropdown built from whatever makes actually exist in the active listings right now (set in the controller). %>
      <label for="make" class="block text-xs font-medium text-gray-500">Make</label>
      <select name="make" id="make" class="mt-1 block rounded border-gray-300 text-sm">
        <option value="">All makes</option>
        <% @makes.each do |make| %>
          <%# `selected` re-checks whichever option matches the current filter, so the dropdown doesn't reset itself after submitting. %>
          <option value="<%= make %>" <%= "selected" if params[:make] == make %>><%= make %></option>
        <% end %>
      </select>
    </div>

    <div>
      <label for="model" class="block text-xs font-medium text-gray-500">Model</label>
      <select name="model" id="model" class="mt-1 block rounded border-gray-300 text-sm">
        <option value="">All models</option>
        <% @models.each do |model| %>
          <option value="<%= model %>" <%= "selected" if params[:model] == model %>><%= model %></option>
        <% end %>
      </select>
    </div>

    <div>
      <label for="source" class="block text-xs font-medium text-gray-500">Source</label>
      <select name="source" id="source" class="mt-1 block rounded border-gray-300 text-sm">
        <option value="">All sources</option>
        <% @sources.each do |source| %>
          <option value="<%= source %>" <%= "selected" if params[:source] == source %>><%= source.titleize %></option>
        <% end %>
      </select>
    </div>

    <div class="flex items-center gap-2">
      <%# Checkbox for the "great deals only" filter -- checked stays true across a re-submit the same way the dropdowns do above. %>
      <input type="checkbox" name="great" id="great" value="1" <%= "checked" if params[:great].present? %> class="rounded border-gray-300">
      <label for="great" class="text-sm text-gray-700">Great deals only</label>
    </div>

    <%# Plain submit button -- reloads the page with whatever filters were picked. %>
    <button type="submit" class="rounded bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700">Filter</button>
    <%# Plain link back to the unfiltered view. %>
    <%= link_to "Clear filters", listings_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  <% end %>

  <%# The actual listings table. %>
  <div class="mt-6 overflow-x-auto rounded-lg border border-gray-200 bg-white">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-2 text-left font-semibold text-gray-600">Score</th>
          <th class="px-4 py-2 text-left font-semibold text-gray-600">Price</th>
          <th class="px-4 py-2 text-left font-semibold text-gray-600">Car</th>
          <th class="px-4 py-2 text-left font-semibold text-gray-600">Mileage</th>
          <th class="px-4 py-2 text-left font-semibold text-gray-600">Location</th>
          <th class="px-4 py-2 text-left font-semibold text-gray-600">Source</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <%# Looping over @listings (already sorted best-first by the controller) and rendering one row per listing. %>
        <% @listings.each do |listing| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-2">
              <%# Green for a flagged great deal, otherwise a plain gray badge with the raw score -- keeps the strongest visual signal reserved for what actually matters (is_great_deal), same as the Discord alert's color choice. %>
              <span class="inline-block rounded px-2 py-0.5 text-xs font-semibold <%= listing.is_great_deal? ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-700" %>">
                <%= listing.deal_score ? number_with_precision(listing.deal_score, precision: 0) : "?" %>/100
              </span>
            </td>
            <td class="px-4 py-2 font-medium text-gray-900">$<%= number_with_delimiter(listing.price_usd.round) %></td>
            <td class="px-4 py-2">
              <%# Links straight out to the original listing on whichever marketplace it came from. %>
              <%= link_to "#{listing.year || '?'} #{listing.make || '?'} #{listing.model || '?'}", listing.url, target: "_blank", rel: "noopener", class: "text-blue-700 hover:underline" %>
            </td>
            <td class="px-4 py-2 text-gray-600"><%= listing.mileage ? "#{number_with_delimiter(listing.mileage)} mi" : "?" %></td>
            <td class="px-4 py-2 text-gray-600"><%= listing.location %></td>
            <td class="px-4 py-2 text-gray-600"><%= listing.source.titleize %></td>
          </tr>
        <% end %>

        <%# Empty state -- shown only when there's nothing to list, so the page doesn't just render a bare, confusing empty table. %>
        <% if @listings.empty? %>
          <tr>
            <td colspan="6" class="px-4 py-8 text-center text-gray-500">
              No listings yet. The scraper hasn't run, or nothing matched your filters.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
